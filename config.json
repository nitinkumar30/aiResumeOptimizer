{
  "project": "AI Resume Optimizer",
  "version": "2.0.0",
  "description": "n8n workflow for ATS-optimized resume generation with multi-model AI support",
  "models": {
    "google_gemini": {
      "parsing": ["models/gemini-2.0-flash-lite-001", "models/gemini-2.5-flash-image"],
      "generation": ["models/gemini-2.5-flash-image", "models/gemini-3.1-flash-image-preview", "models/gemini-3-pro-image-preview"],
      "scoring": ["models/gemini-3-pro-image-preview"]
    },
    "openai": {
      "parsing": ["gpt-5-mini", "gpt-5.4-image-2"],
      "generation": ["gpt-5.4-image-2"],
      "scoring": ["gpt-5.4-image-2"]
    },
    "openrouter": {
      "auto_routing": ["openrouter/auto"]
    }
  },
  "workflow": {
    "total_nodes": 19,
    "core_agents": ["Resume extractor", "JD extractor", "Generated resume unformatted", "ATS Score Agent", "Cover Letter Agent"],
    "code_nodes": ["Prepare compilation ready", "Compile & convert to pdf file", "Build Caption + Cover Letter"],
    "delivery": ["Send resume via telegram", "Send Cover Letter via Telegram"]
  },
  "features": {
    "ats_scoring": {
      "enabled": true,
      "factors": [
        {"name": "Keyword Coverage", "weight": 0.40},
        {"name": "Skills Alignment", "weight": 0.30},
        {"name": "Experience Relevance", "weight": 0.20},
        {"name": "Role Title Match", "weight": 0.10}
      ]
    },
    "cover_letter": {"enabled": true, "format": "HTML with inline CSS"},
    "parallel_processing": {"resume_and_jd": true},
    "error_handling": {"retry_on_fail": true, "max_retries": 5}
  }
}
